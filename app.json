{
  "expo": {
    "name": "NGA 阅读器",
    "slug": "ng2",
    "owner": "lemoncola",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ng2",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FCF4E1",
    "android": {
      "package": "com.chasel.ng2",
      "versionCode": 2,
      "backgroundColor": "#FCF4E1",
      "adaptiveIcon": {
        "backgroundColor": "#14796B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            { "scheme": "https" },
            { "scheme": "http" },
            { "host": "bbs.nga.cn" },
            { "host": "ngabbs.com" },
            { "host": "bbs.ngacn.cc" },
            { "host": "nga.178.com" },
            { "host": "nga.donews.com" },
            { "pathPrefix": "/read.php" },
            { "pathPrefix": "/thread.php" }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "./plugins/with-high-refresh-rate",
      "./plugins/with-profileable",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCF4E1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#1C1C1B",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "179a366c-e102-40e0-b23c-65ab21ead508"
      }
    }
  }
}

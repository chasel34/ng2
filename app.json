{
  "expo": {
    "name": "NGA 阅读器",
    "slug": "ng2",
    "owner": "lemoncola",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ng2",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.chasel.ng2",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#14796B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "bbs.nga.cn",
              "pathPrefix": "/read.php"
            },
            {
              "scheme": "https",
              "host": "bbs.nga.cn",
              "pathPrefix": "/thread.php"
            },
            {
              "scheme": "https",
              "host": "ngabbs.com",
              "pathPrefix": "/read.php"
            },
            {
              "scheme": "https",
              "host": "ngabbs.com",
              "pathPrefix": "/thread.php"
            },
            {
              "scheme": "https",
              "host": "bbs.ngacn.cc",
              "pathPrefix": "/read.php"
            },
            {
              "scheme": "https",
              "host": "bbs.ngacn.cc",
              "pathPrefix": "/thread.php"
            },
            {
              "scheme": "https",
              "host": "nga.178.com",
              "pathPrefix": "/read.php"
            },
            {
              "scheme": "https",
              "host": "nga.178.com",
              "pathPrefix": "/thread.php"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14796B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "179a366c-e102-40e0-b23c-65ab21ead508"
      }
    }
  }
}

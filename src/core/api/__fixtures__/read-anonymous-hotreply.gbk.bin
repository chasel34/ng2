:{"0":"学徒","1":98528,"2":39},"73":{"0":"学徒","1":360672,"2":73}},"__MEDALS":{"347":{"0":"347.gif","1":"企鹅帽","2":"企鹅帽","3":347},"260":{"0":"260.gif","1":"一周年","2":"连续签到一年","3":260}},"__REPUTATIONS":{"-7955747":{"66313282":0,"10315413":0,"63485408":0,"42966095":-150,"791753":0,"67089404":-300,"8627187":0,"97386":0,"34345485":0,"66874049":0,"7046141":0,"38205463":0,"264251":0,"63692540":0,"66980048":0,"0":"用户圣光礼赞(7955747)的声望"}},"-1":{"uid":0,"username":"#anony_c26f8c0c44685c40baff70f6c803f001","groupid":-1,"memberid":39,"bit_data":64,"buffs":{"103":{"0":0,"1":1786205829,"2":103,"3":"","4":"","5":""}}},"-2":{"uid":0,"username":"#anony_c26f8c0c44685c40baff70f6c803f001","groupid":-1,"memberid":39,"bit_data":64,"buffs":{"103":{"0":0,"1":1786205829,"2":103,"3":"","4":"","5":""}}}},"__R":{"0":{"content":"论坛里熟人有点多，但是又无处宣泄，匿了。<br/>结婚几年，已经俩娃，也就觉得老婆是情绪两极分化的很明显，但是就觉得是生娃导致的情绪波动。偶尔说些不着边际的话也就当耍耍小性子。<br/>直到最近闹着要离婚，然后打电话给我父母说我给她水杯里下药，导致她身体不适。拉着老丈人丈母娘六人会谈时候，看到他们表情明显不对，我就感觉不大好。<br/>直到拉去医院检查，老婆和老丈人堆着医生说出高中时候就确诊过精神分裂，用药用了几年之后自己把药停了，医生做了简单问答之后基本就判断复发，而我坐在对面只感觉天塌了一样。","alterinfo":"","tid":46186286,"score":15,"score_2":0,"postdate":"2026-02-11 17:37","authorid":-1,"subject":"天塌了，结婚四年，才知道老婆有精神分裂病史，并且复发","type":33816608,"fid":-7955747,"pid":0,"recommend":0,"follow":0,"lou":0,"content_length":472,"from_client":"8 Android","17":",857843067,857843681,857843919,857842785","postdatetimestamp":1770802621,"hotreply_id":{"0":"","1":857843067,"2":857843681,"3":857843919,"4":857842785},"hotreply":{"0":{"pid":857843067,"fid":-7955747,"tid":46186286,"authorid":791753,"type":0,"score":588,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:41","subject":"","alterinfo":"","content":"你这辈子完了，这种遗传因素很高的病，还2娃。","lou":5,"content_length":43,"from_client":"0 /","postdatetimestamp":1770802877},"1":{"pid":857843681,"fid":-7955747,"tid":46186286,"authorid":66874049,"type":0,"score":572,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:46","subject":"","alterinfo":"","content":"隐瞒重大疾病病史的可以起诉离婚，不过你是国男，也不好判，性别一换保证判[s:ac:哭笑]","lou":13,"content_length":68,"from_client":"7 iOS","postdatetimestamp":1770803191},"2":{"pid":857843919,"fid":-7955747,"tid":46186286,"authorid":42966095,"type":0,"score":341,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:48","subject":"","alterinfo":"","content":"[b]Reply to [pid=857843418,46186286,1]Reply[/pid] Post by [uid]#anony_c26f8c0c44685c40baff70f6c803f001[/uid][color=gray](9楼)[/color] (2026-02-11 17:44)[/b]<br/>你怎么还心疼上了，他们向你隐瞒重大病情的时候有心疼你吗？让你龟完了","lou":16,"content_length":129,"reply_to":857843418,"from_client":"0 /","postdatetimestamp":1770803296},"3":{"pid":857842785,"fid":-7955747,"tid":46186286,"authorid":66313282,"type":0,"score":288,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:38","subject":"","alterinfo":"","content":"精神病 不会还给彩礼了吗 <br/>以后不光查征信 还得查病史了 <br/>查来查去 不结拉倒 只恋爱 不结婚 完美！","lou":1,"content_length":82,"from_client":"0 /","postdatetimestamp":1770802726}}},"1":{"pid":857842785,"fid":-7955747,"tid":46186286,"authorid":66313282,"type":0,"score":288,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:38","subject":"","alterinfo":"","content":"精神病 不会还给彩礼了吗 <br/>以后不光查征信 还得查病史了 <br/>查来查去 不结拉倒 只恋爱 不结婚 完美！","lou":1,"content_length":82,"from_client":"0 /","postdatetimestamp":1770802726},"2":{"pid":857842927,"fid":-7955747,"tid":46186286,"authorid":10315413,"type":0,"score":39,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:40","subject":"","alterinfo":"","content":"你这完全不做背调的么？[s:ac:汗]","lou":2,"content_length":20,"from_client":"0 /","postdatetimestamp":1770802802},"3":{"pid":857842933,"fid":-7955747,"tid":46186286,"authorid":63485408,"type":0,"score":7,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:40","subject":"","alterinfo":"","content":"哪里找的老婆 避雷一下[s:a2:大哭]","lou":3,"content_length":18,"from_client":"7 iOS","postdatetimestamp":1770802805},"4":{"pid":857843044,"fid":-7955747,"tid":46186286,"authorid":42966095,"type":0,"score":56,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:41","subject":"","alterinfo":"","content":"[新婚夜被打、发现妻子患精神病！11万彩礼能退吗？法院判决引争议] 信源 [url]https://baijiahao.baidu.com/s?id=1855632865702599469&amp;wfr=spider&amp;for=pc[/url]","lou":4,"content_length":72,"from_client":"0 /","postdatetimestamp":1770802863},"5":{"pid":857843067,"fid":-7955747,"tid":46186286,"authorid":791753,"type":0,"score":588,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:41","subject":"","alterinfo":"","content":"你这辈子完了，这种遗传因素很高的病，还2娃。","lou":5,"content_length":43,"from_client":"0 /","postdatetimestamp":1770802877},"6":{"pid":857843145,"fid":-7955747,"tid":46186286,"authorid":67089404,"type":0,"score":16,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:42","subject":"","alterinfo":"","content":"赶紧离婚，精神有问题的过不了一点","lou":6,"content_length":32,"from_client":"0 /","postdatetimestamp":1770802924},"7":{"pid":857843331,"fid":-7955747,"tid":46186286,"authorid":8627187,"type":0,"score":57,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:43","subject":"","alterinfo":"","content":"[quote][pid=857842927,46186286,1]Reply[/pid] [b]Post by [uid=10315413]清风拂过的气息[/uid] (2026-02-11 17:40):[/b]<br/><br/>你这完全不做背调的么？[s:ac:汗][/quote]<br/><br/>婚检都不告诉配偶了，这咋调查[s:ac:瞎]","lou":8,"content_length":31,"from_client":"8 Android","reply_to":857842927,"postdatetimestamp":1770803017},"8":{"pid":857843418,"fid":-7955747,"tid":46186286,"authorid":-2,"type":262144,"score":0,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:44","subject":"","alterinfo":"","content":"老婆是外地考过来的公务员，谁能往这方面想呢。<br/>而且暂时心里最大的感受还是两个。<br/>一个是心疼，一想到很多时候她和我吵架是真的出现幻觉，然后把我逼急了就吼她，她当时应该真的很害怕。<br/>二个是难过，她现在满脑子都是遇到的坏人坏事都是我安排的，只要和我离婚，这些就能避免了，看到她那种态度我就特别难过。","lou":9,"content_length":286,"from_client":"8 Android","postdatetimestamp":1770803067},"9":{"pid":857843424,"fid":-7955747,"tid":46186286,"authorid":97386,"type":0,"score":30,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:44","subject":"","alterinfo":"","content":"这辈子完了，小孩也难了，过一天是一天吧。","lou":10,"content_length":40,"from_client":"8 Android","postdatetimestamp":1770803069},"10":{"pid":857843471,"fid":-7955747,"tid":46186286,"authorid":97386,"type":0,"score":6,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:44","subject":"","alterinfo":"","content":"[quote][pid=857843145,46186286,1]Reply[/pid] [b]Post by [uid=67089404]bestfloor[/uid] (2026-02-11 17:42):[/b]<br/><br/>赶紧离婚，精神有问题的过不了一点[/quote]<br/><br/>这种没法离婚的。","lou":11,"content_length":21,"from_client":"8 Android","reply_to":857843145,"postdatetimestamp":1770803089},"11":{"pid":857843589,"fid":-7955747,"tid":46186286,"authorid":34345485,"type":0,"score":48,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:45","subject":"","alterinfo":"","content":"[quote][pid=857843418,46186286,1]Reply[/pid] [b]Post by [uid]#anony_c26f8c0c44685c40baff70f6c803f001[/uid][color=gray](9楼)[/color] (2026-02-11 17:44):[/b]<br/><br/>老婆是外地考过来的公务员，谁能往这方面想呢。<br/>而且暂时心里最大的感受还是两个。<br/>一个是心疼，一想到很多时候她和我吵架是真的出现幻觉，然后把我逼急了就吼她，她当时应该真的很害怕。<br/>二个是难过，她现在满脑子都是遇到的坏人坏事都是我安排的，只要和我离婚，这些就能避免了，看到她那种态度我就特别难过。[/quote]<br/><br/>第二点看出来已经复发了 送医治疗吧","lou":12,"content_length":37,"from_client":"8 Android","reply_to":857843418,"postdatetimestamp":1770803147},"12":{"pid":857843681,"fid":-7955747,"tid":46186286,"authorid":66874049,"type":0,"score":572,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:46","subject":"","alterinfo":"","content":"隐瞒重大疾病病史的可以起诉离婚，不过你是国男，也不好判，性别一换保证判[s:ac:哭笑]","lou":13,"content_length":68,"from_client":"7 iOS","postdatetimestamp":1770803191},"13":{"pid":857843711,"fid":-7955747,"tid":46186286,"authorid":7046141,"type":0,"score":20,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:46","subject":"","alterinfo":"","content":"[quote][pid=857842927,46186286,1]Reply[/pid] [b]Post by [uid=10315413]清风拂过的气息[/uid] (2026-02-11 17:40):[/b]<br/><br/>你这完全不做背调的么？[s:ac:汗][/quote]<br/><br/>普通人哪来的渠道还能调查这个","lou":14,"content_length":33,"from_client":"8 Android","reply_to":857842927,"postdatetimestamp":1770803205},"14":{"pid":857843845,"fid":-7955747,"tid":46186286,"authorid":38205463,"type":0,"score":88,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:47","subject":"","alterinfo":"[E1770840143 0 0]	","content":"精神分裂是重大疾病，可以主张撤销婚姻，不是离婚  <br/>看了后面评论发现有些人在这方面认知不够，精神病分很多种，精神分裂症是精神病里面有攻击性的一种，患者发病会出现幻觉，突然砍死家人的例子都有","lou":15,"content_length":182,"from_client":"8 Android","postdatetimestamp":1770803262},"15":{"pid":857843919,"fid":-7955747,"tid":46186286,"authorid":42966095,"type":0,"score":341,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:48","subject":"","alterinfo":"","content":"[b]Reply to [pid=857843418,46186286,1]Reply[/pid] Post by [uid]#anony_c26f8c0c44685c40baff70f6c803f001[/uid][color=gray](9楼)[/color] (2026-02-11 17:44)[/b]<br/>你怎么还心疼上了，他们向你隐瞒重大病情的时候有心疼你吗？让你龟完了","lou":16,"content_length":129,"reply_to":857843418,"from_client":"0 /","postdatetimestamp":1770803296},"16":{"pid":857844063,"fid":-7955747,"tid":46186286,"authorid":264251,"type":0,"score":26,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:49","subject":"","alterinfo":"","content":"这玩意最可怕的是遗传！","lou":17,"content_length":22,"from_client":"7 iOS","postdatetimestamp":1770803375},"17":{"pid":857844095,"fid":-7955747,"tid":46186286,"authorid":63692540,"type":0,"score":64,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:49","subject":"","alterinfo":"","content":"给楼主泼个冷水吧，成年人有精神分裂症的话几乎没有可能治愈，但是积极治疗可以依靠不断迭代的镇静类药物<br/>很好的控制病情的发展，长期按时按医嘱服药+定期复诊+病情严重时去专门的医院住院治疗，我只能帮你到这里了。","lou":18,"content_length":200,"from_client":"0 /","postdatetimestamp":1770803396},"18":{"pid":857844135,"fid":-7955747,"tid":46186286,"authorid":66980048,"type":0,"score":12,"score_2":0,"recommend":0,"postdate":"2026-02-11 17:50","subject":"","alterinfo":"","content":"精神病史遗传吧<br/>哎 坑人","lou":19,"content_length":20,"from_client":"7 iOS","postdatetimestamp":1770803420}},"__T":{"fid":-7955747,"tid":46186286,"topic_misc":"","subject":"天塌了，结婚四年，才知道老婆有精神分裂病史，并且复发","locked":0,"recommend":0,"quote_to":"","quote_from":0,"type":262176,"replies":241,"authorid":-3,"postdate":1770802621,"lastpost":1786118314,"jdata":"","author":"#anony_c26f8c0c44685c40baff70f6c803f001","lastposter":"firedog8888","digest":0,"lastmodify":1786118923,"tpid":0,"post_misc_var":{"content_length":472,"fid":-7955747,"17":",857843067,857843681,857843919,857842785"},"this_visit_rows":242},"__F":{"custom_level":"[{r:-501,n:\"离人\"},{r:-450,n:\"遗恨\"},{r:-300,n:\"负心\"},{r:-150,n:\"前任\"},{r:-1,n:\"过客\"},{r:0,n:\"酌客\"},{r:150,n:\"说书人\"},{r:1500,n:\"万人迷\"}]","name":"晴风村"},"__R__ROWS":19,"__R__ROWS_PAGE":20,"__ROWS":242,"__PAGE":1},"encode":"GBK","time":1786119429}
<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      不引 com.google.android.material 的 XML 主题:整个 UI 是 Compose,平台主题只负责
      「window 出现到第一帧 Compose 之间」那段窗口外观。windowBackground 必须与 Compose
      主题底色一致,否则冷启动会多一帧异色闪(spec §五 十场景闸第 1 条)。
    -->
    <style name="Theme.NG2N" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
